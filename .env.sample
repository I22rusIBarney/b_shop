# Обычно этот файл создаёт install.sh. Вручную: cp .env.sample .env, заполнить, docker compose up -d.
# Всё остальное (ЮKassa, «Мой налог», почта, тарифы, тексты, рефералка…) настраивается в админке.

# Домен кабинета/Mini App и полный адрес без / на конце
DOMAIN=shop.example.com
PUBLIC_URL=https://shop.example.com

# Токен бота из @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую (получат доступ к админке)
ADMIN_TELEGRAM_IDS=

# Случайная строка от 32 символов: шифрует ключи в базе. Не меняйте после запуска!
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=

# Панель Remnawave: адрес и API-токен
REMNAWAVE_URL=https://panel.example.com
REMNAWAVE_TOKEN=
# local — если панель доступна по http внутри docker-сети
REMNAWAVE_MODE=
# Необязательно: cookie "имя=значение", если панель за защитой reverse proxy
REMNAWAVE_COOKIE=

# База данных
POSTGRES_USER=bshop
POSTGRES_PASSWORD=
POSTGRES_DB=bshop

# Образ, порт на 127.0.0.1 (для nginx на этом же сервере)
BSHOP_IMAGE=ghcr.io/i22rusibarney/b_shop:latest
BSHOP_PORT=8080

# HTTPS встроенным Caddy (если 80/443 свободны): COMPOSE_PROFILES=caddy, почта для Let's Encrypt (можно пусто)
# и cp Caddyfile.example Caddyfile (впишите домен). С nginx на сервере — COMPOSE_PROFILES= пусто.
COMPOSE_PROFILES=caddy
ACME_EMAIL=
