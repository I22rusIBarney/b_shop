# --- Только то, что нужно для запуска. Всё остальное (ЮKassa, «Мой налог», почта,
# --- тарифы, тексты, рефералка...) настраивается в админке веб-приложения.

# Адрес веб-приложения (Mini App и кабинет в браузере), без / на конце
PUBLIC_URL=https://shop.bobrgo.com

# Токен бота из @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую (получат доступ к админке)
ADMIN_TELEGRAM_IDS=

# Случайная строка от 32 символов: шифрует ключи в базе. Не меняйте после запуска!
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=

# Панель Remnawave: адрес и API-токен со всеми правами
REMNAWAVE_URL=https://panel.bobrgo.com
REMNAWAVE_TOKEN=
# local — если панель доступна по http внутри docker-сети
REMNAWAVE_MODE=
# Необязательно: cookie "имя=значение", если панель за защитой reverse proxy
REMNAWAVE_COOKIE=

# База данных
POSTGRES_USER=bshop
POSTGRES_PASSWORD=
POSTGRES_DB=bshop
